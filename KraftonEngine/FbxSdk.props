<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <FbxSdkRoot>$(MSBuildProjectDirectory)\ThirdParty\FBXSDK</FbxSdkRoot>
    <FbxSdkIncludeDir>$(FbxSdkRoot)\include</FbxSdkIncludeDir>

    <!-- Debug uses FBX SDK debug libs/dlls. All release-like custom configs use release. -->
    <FbxSdkLibDir Condition="'$(Configuration)'=='Debug'">$(FbxSdkRoot)\lib\x64\debug</FbxSdkLibDir>
    <FbxSdkBinDir Condition="'$(Configuration)'=='Debug'">$(FbxSdkRoot)\lib\x64\debug</FbxSdkBinDir>
    <FbxSdkLibDir Condition="'$(FbxSdkLibDir)'==''">$(FbxSdkRoot)\lib\x64\release</FbxSdkLibDir>
    <FbxSdkBinDir Condition="'$(FbxSdkBinDir)'==''">$(FbxSdkRoot)\lib\x64\release</FbxSdkBinDir>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <PreprocessorDefinitions>
        FBXSDK_SHARED;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <AdditionalIncludeDirectories>
        $(FbxSdkIncludeDir);
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>

    <Link>
      <AdditionalLibraryDirectories>
        $(FbxSdkLibDir);
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        libfbxsdk-md.lib;
        libxml2-md.lib;
        zlib-md.lib;
        wininet.lib;
        advapi32.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="CopyFbxSdkRuntimeDlls"
          AfterTargets="Build"
          Condition="'$(Platform)'=='x64' And Exists('$(FbxSdkBinDir)\libfbxsdk.dll')">
    <ItemGroup>
      <FbxSdkRuntimeDll Include="$(FbxSdkBinDir)\libfbxsdk.dll" />
    </ItemGroup>
    <Message Importance="High"
             Text="Copying FBX SDK runtime DLLs from $(FbxSdkBinDir) to $(TargetDir)" />
    <Copy SourceFiles="@(FbxSdkRuntimeDll)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
